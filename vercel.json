{
  "version": 2,
  "outputDirectory": "dist/spa",
  "buildCommand": "npm run build:static",
  "installCommand": "npm ci",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/tour-details/land-of-kings",
      "destination": "/tour-details/rajasthan-private-tour-land-of-kings-11-days",
      "permanent": true
    },
    {
      "source": "/tours/:slug",
      "destination": "/tour-details/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/adm",
      "destination": "/spa"
    },
    {
      "source": "/tour-details/:slug",
      "destination": "/spa"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "VITE_API_URL": "https://api.orbittrails.com"
  },
  "images": {
    "sizes": [
      320,
      480,
      640,
      960,
      1280,
      1920
    ],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "images.orbittrails.com"
      }
    ],
    "formats": [
      "image/avif",
      "image/webp"
    ],
    "minimumCacheTTL": 2592000
  }
}
